{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/supabase/(.*)",
            "destination": "https://ufxjvugkmiorxlogvcmx.supabase.co/$1"
        },
        {
            "source": "/api/aladhan/(.*)",
            "destination": "https://api.aladhan.com/$1"
        },
        {
            "source": "/api/quran/(.*)",
            "destination": "https://api.alquran.cloud/$1"
        },
        {
            "source": "/api/nominatim/(.*)",
            "destination": "https://nominatim.openstreetmap.org/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)\\.apk",
            "headers": [
                {
                    "key": "Content-Disposition",
                    "value": "attachment"
                },
                {
                    "key": "Content-Type",
                    "value": "application/vnd.android.package-archive"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                }
            ]
        }
    ]
}